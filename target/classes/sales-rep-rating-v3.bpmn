<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
        xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
        xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
        xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
        xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
        id="Definitions_1"
        targetNamespace="http://finos.org/fluxnova/demo">

    <bpmn:process
            id="salesRepRatingProcessV3"
            name="Proceso V3 de evaluación de comunicación comercial"
            isExecutable="true"
            camunda:historyTimeToLive="180">

        <bpmn:startEvent id="StartEvent_1" name="Inicio">
            <bpmn:outgoing>Flow_1</bpmn:outgoing>
        </bpmn:startEvent>

        <bpmn:serviceTask
                id="Activity_PrepareInput"
                name="Pipeline: transcribir y preparar comunicación para API"
                camunda:delegateExpression="${prepareCommunicationInputDelegate}">
            <bpmn:incoming>Flow_1</bpmn:incoming>
            <bpmn:outgoing>Flow_2</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:serviceTask
                id="Activity_RateCommunication"
                name="IA: evaluar comunicación comercial"
                camunda:delegateExpression="${salesCommunicationRatingV3Delegate}">
            <bpmn:incoming>Flow_2</bpmn:incoming>
            <bpmn:incoming>Flow_6</bpmn:incoming>
            <bpmn:outgoing>Flow_3</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:userTask
                id="Activity_ManagerReview"
                name="Manager: revisar evaluación de IA"
                camunda:candidateGroups="managers">
            <bpmn:incoming>Flow_3</bpmn:incoming>
            <bpmn:outgoing>Flow_4</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:exclusiveGateway id="Gateway_ManagerDecision" name="¿Manager aprueba resultado?">
            <bpmn:incoming>Flow_4</bpmn:incoming>
            <bpmn:outgoing>Flow_5</bpmn:outgoing>
            <bpmn:outgoing>Flow_6</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <bpmn:serviceTask
                id="Activity_CreateEducationalComment"
                name="IA: generar comentario educativo"
                camunda:delegateExpression="${createEducationalCommentDelegate}">
            <bpmn:incoming>Flow_5</bpmn:incoming>
            <bpmn:outgoing>Flow_7</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:endEvent id="EndEvent_1" name="Fin">
            <bpmn:incoming>Flow_7</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_PrepareInput"/>
        <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_PrepareInput" targetRef="Activity_RateCommunication"/>
        <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_RateCommunication" targetRef="Activity_ManagerReview"/>
        <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_ManagerReview" targetRef="Gateway_ManagerDecision"/>

        <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_ManagerDecision" targetRef="Activity_CreateEducationalComment">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${managerApproved == true}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>

        <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_ManagerDecision" targetRef="Activity_RateCommunication">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${managerApproved == false}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>

        <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_CreateEducationalComment" targetRef="EndEvent_1"/>

    </bpmn:process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_1">
        <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="salesRepRatingProcessV3">

            <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
                <dc:Bounds x="80" y="200" width="36" height="36"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="Activity_PrepareInput_di" bpmnElement="Activity_PrepareInput">
                <dc:Bounds x="160" y="170" width="220" height="95"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="Activity_RateCommunication_di" bpmnElement="Activity_RateCommunication">
                <dc:Bounds x="430" y="170" width="190" height="95"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="Activity_ManagerReview_di" bpmnElement="Activity_ManagerReview">
                <dc:Bounds x="680" y="170" width="190" height="95"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="Gateway_ManagerDecision_di" bpmnElement="Gateway_ManagerDecision" isMarkerVisible="true">
                <dc:Bounds x="930" y="190" width="60" height="60"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="Activity_CreateEducationalComment_di" bpmnElement="Activity_CreateEducationalComment">
                <dc:Bounds x="1040" y="170" width="200" height="95"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
                <dc:Bounds x="1290" y="200" width="36" height="36"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
                <di:waypoint x="116" y="218"/>
                <di:waypoint x="160" y="218"/>
            </bpmndi:BPMNEdge>

            <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
                <di:waypoint x="380" y="218"/>
                <di:waypoint x="430" y="218"/>
            </bpmndi:BPMNEdge>

            <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
                <di:waypoint x="620" y="218"/>
                <di:waypoint x="680" y="218"/>
            </bpmndi:BPMNEdge>

            <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
                <di:waypoint x="870" y="218"/>
                <di:waypoint x="930" y="220"/>
            </bpmndi:BPMNEdge>

            <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
                <di:waypoint x="990" y="220"/>
                <di:waypoint x="1040" y="217"/>
            </bpmndi:BPMNEdge>

            <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
                <di:waypoint x="960" y="190"/>
                <di:waypoint x="960" y="110"/>
                <di:waypoint x="525" y="110"/>
                <di:waypoint x="525" y="170"/>
            </bpmndi:BPMNEdge>

            <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
                <di:waypoint x="1240" y="217"/>
                <di:waypoint x="1290" y="218"/>
            </bpmndi:BPMNEdge>

        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>

</bpmn:definitions>