        <di:waypoint x="1740" y="268" />
        <di:waypoint x="1800" y="268" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Maintenance_To_Response_di" bpmnElement="Flow_Maintenance_To_Response">
        <di:waypoint x="1680" y="320" />
        <di:waypoint x="1740" y="320" />
        <di:waypoint x="1740" y="268" />
        <di:waypoint x="1800" y="268" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Human_To_Response_di" bpmnElement="Flow_Human_To_Response">
        <di:waypoint x="1680" y="440" />
        <di:waypoint x="1740" y="440" />
        <di:waypoint x="1740" y="268" />
        <di:waypoint x="1800" y="268" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Response_To_End_di" bpmnElement="Flow_Response_To_End">
        <di:waypoint x="1970" y="268" />
        <di:waypoint x="2080" y="268" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>